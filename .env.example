# ═══════════════════════════════════════════════════════════════════
#  PraroopAI — configuration
# ═══════════════════════════════════════════════════════════════════

# ── Logging ────────────────────────────────────────────────────────
# TRACE = full prompts and full model replies
# DEBUG = every LLM call with timing and a response preview
# INFO  = pipeline milestones (default)
LOG_LEVEL=INFO

# ── LLM provider ───────────────────────────────────────────────────
# ollama | openai | openrouter | anthropic | openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_REQUEST_TIMEOUT=120

# ── Pipeline tuning ────────────────────────────────────────────────
# One LLM call per section (RFP has 7, DPR has 11).
# SECTION_RETRIES=1 roughly halves the worst-case run time.
SECTION_RETRIES=2
MIN_SECTION_CHARS=180
MAX_REVIEW_LOOPS=3

# ── Endpoints & keys (fill only the one you use) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1

PRAROOP_PORT=8000
