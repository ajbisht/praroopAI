# ═══════════════════════════════════════════════════════════════════
#  PraroopAI — configuration
# ═══════════════════════════════════════════════════════════════════

# ── Logging ────────────────────────────────────────────────────────
# TRACE   = everything incl. full prompts and full model replies
# DEBUG   = every LLM call with timing, sizes and a response preview
# INFO    = pipeline milestones (default)
# WARNING = only problems
LOG_LEVEL=INFO

# ── LLM provider ───────────────────────────────────────────────────
# ollama | openai | openrouter | anthropic | openai_compatible
LLM_PROVIDER=ollama

# ollama     -> qwen2.5:7b, qwen2.5:14b, llama3.1:8b
# openai     -> gpt-4o-mini
# openrouter -> anthropic/claude-3.5-sonnet
# anthropic  -> claude-3-5-sonnet-20241022
LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_REQUEST_TIMEOUT=120

# ── Pipeline tuning ────────────────────────────────────────────────
# One LLM call per section. An RFP has 7 sections, a DPR has 11.
# Lower SECTION_RETRIES to 1 to roughly halve the worst-case time.
SECTION_RETRIES=2
MIN_SECTION_CHARS=180
MAX_REVIEW_LOOPS=3

# ── Endpoints & keys (fill only the one you use) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1

# ── App ────────────────────────────────────────────────────────────
PRAROOP_PORT=8080
