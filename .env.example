# ═══════════════════════════════════════════════════════════════════
#  PraroopAI — configuration
#  Switch LLM provider by changing ONLY this file. No code changes.
# ═══════════════════════════════════════════════════════════════════

# ollama | openai | openrouter | anthropic | openai_compatible
LLM_PROVIDER=ollama

# Model name must match the provider.
#   ollama            -> qwen2.5:7b, qwen2.5:14b, llama3.1:8b
#   openai            -> gpt-4o-mini, gpt-4o
#   openrouter        -> anthropic/claude-3.5-sonnet
#   anthropic         -> claude-3-5-sonnet-20241022
LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_REQUEST_TIMEOUT=120

# ── Provider endpoints & keys (fill only the one you use) ──────────
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1

# ── App ────────────────────────────────────────────────────────────
PRAROOP_PORT=8080
